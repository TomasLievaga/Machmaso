# Copy to .env.local and fill in from Supabase: Project Settings → API Keys.
# Without these values the app falls back to built-in demo data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key
# Optional locally. On Vercel Production, set to the public site URL so
# confirmation emails link back to it (must be in Supabase Redirect URLs).
NEXT_PUBLIC_SITE_URL=
